{
  "name": "tunisia-cat-dog-survey",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "description": "Citizen-Science Platform for Free-Roaming Cats and Dogs in Tunisia",
  "scripts": {
    "test:security": "pnpm --filter @tunisia-survey/supabase test",
    "test:shared": "pnpm --filter @tunisia-survey/shared test",
    "test:mobile": "pnpm --filter @tunisia-survey/mobile test",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @tunisia-survey/shared build && pnpm --filter @tunisia-survey/design-tokens build && cd apps/mobile && npx tsc --noEmit",
    "build": "pnpm -r build",
    "mobile": "pnpm --filter @tunisia-survey/mobile start",
    "dashboard": "pnpm --filter @tunisia-survey/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3"
  }
}
