{
  "name": "tunisia-cat-dog-survey",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "description": "Citizen-Science Platform for Free-Roaming Cats and Dogs in Tunisia",
  "scripts": {
    "test:security": "pnpm --filter @tunisia-survey/supabase test",
    "test:shared": "pnpm --filter @tunisia-survey/shared test",
    "test:mobile": "pnpm --filter @tunisia-survey/mobile test",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @tunisia-survey/shared build && pnpm --filter @tunisia-survey/design-tokens build && cd apps/mobile && npx tsc --noEmit && cd ../dashboard && npx tsc --noEmit",
    "build": "pnpm -r build",
    "postinstall": "pnpm --filter @tunisia-survey/shared build && pnpm --filter @tunisia-survey/design-tokens build",
    "mobile": "pnpm --filter @tunisia-survey/mobile start",
    "dashboard": "pnpm --filter @tunisia-survey/dashboard dev",
    "lint": "eslint . --max-warnings=200",
    "format": "prettier --write",
    "test:sql": "bash supabase/tests/run_sql_behaviour.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --max-warnings=200 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
