# Hawem (حايم) Citizen-Science Platform Mobile Configuration

# Gemini Multimodal AI API Key (Optional for field testing, falls back to offline heuristic)
# Get a key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase Local or Production Endpoints (Defaults to local Docker instance: 192.168.1.14:54321)
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.14:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Map renderer: Mapbox WebView by default (globe, satellite/outdoors styles)
# Basemap style for MapLibre; defaults to OpenFreeMap "liberty". Point at your
# self-hosted Protomaps style.json for production.
EXPO_PUBLIC_MAP_STYLE_URL=
# Set to "maplibre" to use the native MapLibre renderer in dev/production builds
EXPO_PUBLIC_MAP_RENDERER=
