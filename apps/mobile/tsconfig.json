{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "app/**/*", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["src/__tests__"]
}
